{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@cvg/database": ["../../packages/database/src"],
      "@cvg/events": ["../../packages/events/src"],
      "@cvg/shared": ["../../packages/shared/src"],
      "@cvg/realtime": ["../../packages/realtime/src"],
      "@cvg/alerts": ["../../modules/alerts/src"],
      "@cvg/audit": ["../../modules/audit/src"],
      "@cvg/auth": ["../../packages/auth/src"],
      "@cvg/chat": ["../../modules/chat/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/__tests__"]
}
