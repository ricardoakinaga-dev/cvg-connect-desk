# ============================================
# CVG Connect Desk — Variáveis de Produção
# ============================================
# Este arquivo deve ser configurado antes de subir para produção.
# NUNCA commite valores reais.

# ============================================
# Banco de Dados (Obrigatório)
# ============================================
DATABASE_URL=postgresql://connect_desk:SUA_SENHA_FORTE@postgres:5432/connect_desk_db
POSTGRES_USER=connect_desk
POSTGRES_PASSWORD=SUA_SENHA_FORTE
POSTGRES_DB=connect_desk_db

# ============================================
# Redis (Obrigatório para rate-limit distribuído)
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Aplicação — API
# ============================================
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# Segurança (OBRIGATÓRIO!)
# ============================================
WEBHOOK_SECRET=GERE_UM_TOKEN_FORTRE_AQUI
CORS_ORIGIN=https://seu-dominio.com
# Nunca use "true" em produção; informe os IPs/CIDRs dos proxies reais.
TRUST_PROXY=10.0.0.10,10.0.0.11
# Obrigatório para proteger /events e o fallback HTTP do realtime.
INTERNAL_EVENTS_SECRET=GERE_UM_TOKEN_FORTE_EXCLUSIVO_PARA_EVENTOS_INTERNOS

# ============================================
# Mídia — obrigatório em produção
# ============================================
MEDIA_STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=SEU_BUCKET_PRIVADO
S3_ACCESS_KEY_ID=FORNECIDO_PELO_SECRET_MANAGER
S3_SECRET_ACCESS_KEY=FORNECIDO_PELO_SECRET_MANAGER
MEDIA_REQUIRE_SCAN=all
MEDIA_PIPELINE_ENABLED=true
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================================
# Observabilidade — métricas (OBRIGATÓRIO!)
# ============================================
# /metrics exige Bearer token em produção (fail-closed: sem token/rede → 503).
METRICS_TOKEN=GERE_UM_TOKEN_FORTE_EXCLUSIVO_PARA_METRICAS
# Opcional (defesa em profundidade): restringe /metrics por CIDR.
# METRICS_ALLOWED_CIDRS=172.16.0.0/12

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# ============================================
# Realtime (WebSocket)
# ============================================
REDIS_REQUIRED=true
REALTIME_PORT=8080
REALTIME_POLL_INTERVAL_MS=500
DESK_API_URL=http://desk-api:3000
USE_DATABASE_OUTBOX=true

# ============================================
# Worker
# ============================================
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_PORT=9090
MEDIA_RECOVERY_BATCH_SIZE=50
MEDIA_RECOVERY_LEASE_SECONDS=120
MEDIA_RECOVERY_MAX_ATTEMPTS=8
MEDIA_RECOVERY_BACKOFF_BASE_MS=1000
MEDIA_RECOVERY_BACKOFF_MAX_MS=300000

# ============================================
# Frontend (Vite) — build-time var, não mudar aqui
# ============================================
VITE_API_URL=/api

# ============================================
# Integrações Externas (configure se usar)
# ============================================
GATEWAY_URL=
GATEWAY_API_KEY=
EVOLUTION_API_URL=

# ============================================
# Agent Secretary (IA) — configure se usar
# ============================================
SECRETARY_URL=
SECRETARY_API_KEY=
SECRETARY_TIMEOUT_MS=30000

# ============================================
# Tracing (opcional; obrigatório se OTEL_ENABLED=true)
# ============================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cvg-desk
OTEL_EXPORTER_OTLP_ENDPOINT=
