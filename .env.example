# ============================================
# CVG Connect Desk — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env com valores reais.

# ============================================
# Banco de Dados (Obrigatório)
# ============================================
DATABASE_URL=postgresql://connect_desk:root@localhost:5432/connect_desk_db
POSTGRES_USER=connect_desk
POSTGRES_PASSWORD=root
POSTGRES_DB=connect_desk_db

# ============================================
# Redis (Obrigatório para rate-limit distribuído)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Aplicação — API
# ============================================
PORT=3000
NODE_ENV=development
# DESK_ENV=production  # alternativa para forçar modo produção (verifica NODE_ENV E DESK_ENV)
LOG_LEVEL=info

# ============================================
# Segurança (Obrigatório em produção!)
# ============================================
# WEBHOOK_SECRET: Obrigatório quando NODE_ENV=production ou DESK_ENV=production.
# Sem ele, o webhook rejeita com 500 em produção mas permite bypass em dev (com warning).
# Para produção, gere um token forte e preencha abaixo.
# Assinatura: HMAC-SHA256 sobre `${X-Webhook-Timestamp}.${rawBody}`.
# Anti-replay: X-Webhook-Timestamp (epoch s) + X-Webhook-Event-Id obrigatórios em produção.
JWT_SECRET=change_me_in_production_use_strong_random_key
WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
# Produção: CORS_ORIGIN ausente ou "*" derruba o boot (fail-secure).
MAX_WEBHOOK_CLOCK_SKEW_SECONDS=300
WEBHOOK_EVENT_ID_TTL_SECONDS=86400
# Lista explícita de proxies confiáveis, separada por vírgula. Vazio = não confiar.
TRUST_PROXY=
# Chave compartilhada somente entre realtime-service e desk-api quando o
# fallback HTTP de eventos estiver habilitado.
INTERNAL_EVENTS_SECRET=dev-internal-events-secret

# ============================================
# Bootstrap admin (seed fail-secure)
# ============================================
# Produção exige ADMIN_BOOTSTRAP_EMAIL + ADMIN_BOOTSTRAP_PASSWORD (mín. 12 chars).
# Sem eles, nenhum admin é criado. Nenhuma senha default é usada em produção.
ADMIN_BOOTSTRAP_EMAIL=admin@cvg.com
ADMIN_BOOTSTRAP_PASSWORD=troque-por-senha-forte-com-12-plus-chars

# ============================================
# Sessões
# ============================================
# Tokens NUNCA persistidos em plaintext (apenas SHA-256). Idle 24h default, absoluto 30d.
SESSION_IDLE_TIMEOUT_MS=86400000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Limiters segmentados (fail-secure: skipOnError=false no global):
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=1 minute
RATE_LIMIT_WEBHOOK_MAX=300
RATE_LIMIT_WEBHOOK_WINDOW=1 minute

# ============================================
# Realtime (WebSocket)
# ============================================
REALTIME_PORT=8080
REALTIME_POLL_INTERVAL_MS=500
DESK_API_URL=http://localhost:3000
USE_DATABASE_OUTBOX=true

# ============================================
# Worker
# ============================================
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEALTH_PORT=9090

# ============================================
# Observabilidade — OpenTelemetry (Final-2)
# ============================================
# Desabilitado por padrão (noop seguro). Para Collector OTLP:
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=cvg-desk-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer xxx
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
OTEL_ENABLED=false

# ============================================
# Mídia — storage + scan/quarentena (Final-3/4)
# ============================================
# MEDIA_STORAGE_DRIVER=memory|s3 (memory proibido em produção sem MEDIA_ALLOW_MEMORY=true)
MEDIA_STORAGE_DRIVER=memory
# S3 (MinIO/AWS/R2) quando driver=s3:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=cvg-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Scanner: clamav|fake|vazio. Fake proibido em produção sem MEDIA_ALLOW_FAKE_SCANNER=true.
# MALWARE_SCANNER=
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# MALWARE_SCAN_TIMEOUT_MS=15000
# Política de scan: all|documents|none (default documents — documentos exigem CLEAN, fail-secure)
# MEDIA_REQUIRE_SCAN=documents
# Pipeline profundo em data-URLs embarcadas (opt-in explícito):
# MEDIA_PIPELINE_ENABLED=false
# Fetch controlado de URLs remotas (opt-in; SSRF guard + size cap + sem redirects):
# MEDIA_FETCH_REMOTE=false
# MEDIA_FETCH_TIMEOUT_MS=20000
MEDIA_MAX_BYTES=16777216

# ============================================
# Frontend (Vite)
# ============================================
VITE_API_URL=http://localhost:3000
VITE_REALTIME_URL=ws://localhost:8080

# ============================================
# Integrações Externas
# ============================================
GATEWAY_URL=http://localhost:3100
GATEWAY_API_KEY=
EVOLUTION_API_URL=http://localhost:8082

# ============================================
# Agent Secretary (IA)
# ============================================
SECRETARY_URL=http://localhost:8083
SECRETARY_API_KEY=
SECRETARY_TIMEOUT_MS=30000
